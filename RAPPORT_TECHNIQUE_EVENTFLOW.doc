        <td><span class="highlight">GET</span></td>
        <td>/api/analytics/campaigns/{campaignId}</td>
        <td>Metriques d'une campagne specifique</td>
    </tr>
    <tr>
        <td><span class="highlight">POST</span></td>
        <td>/api/analytics/campaigns</td>
        <td>Cree des metriques campagne</td>
    </tr>
    <tr>
        <td><span class="highlight">POST</span></td>
        <td>/api/analytics/campaigns/calculate</td>
        <td>Calcule les metriques campagnes</td>
    </tr>
    <tr>
        <td><span class="highlight">GET</span></td>
        <td>/api/analytics/events</td>
        <td>Metriques des evenements</td>
    </tr>
    <tr>
        <td><span class="highlight">GET</span></td>
        <td>/api/analytics/events/{eventId}</td>
        <td>Metriques d'un evenement specifique</td>
    </tr>
    <tr>
        <td><span class="highlight">POST</span></td>
        <td>/api/analytics/events</td>
        <td>Cree des metriques evenement</td>
    </tr>
    <tr>
        <td><span class="highlight">POST</span></td>
        <td>/api/analytics/events/calculate</td>
        <td>Calcule les metriques evenements</td>
    </tr>
    <tr style="background-color: #e7f3ff;">
        <td><span class="highlight">POST</span></td>
        <td><strong>/api/analytics/calculate-all</strong></td>
        <td><strong>Calcule toutes les metriques</strong></td>
    </tr>
</table>

